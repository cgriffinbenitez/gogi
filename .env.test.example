# Test environment — local Supabase stack (Option D isolation strategy)
#
# IMPORTANT: These use the same variable names as production (.env.local) intentionally.
# The pipeline's getSupabase() reads NEXT_PUBLIC_SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY
# directly, so tests reuse those names pointing at the local instance. No pipeline code
# changes are required.
#
# Setup:
#   1. Install Supabase CLI: brew install supabase/tap/supabase
#   2. Install Docker Desktop and start it
#   3. From project root: supabase start
#   4. Copy "Project URL" → NEXT_PUBLIC_SUPABASE_URL
#      Copy "Secret"      → SUPABASE_SERVICE_ROLE_KEY
#   5. Save as .env.test (gitignored — never commit real keys)
#
# Run tests: npm run test:integration

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=sb_secret_<your-local-secret-key>
